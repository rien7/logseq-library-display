{
  "name": "logseq-library-display",
  "version": "0.1.12",
  "description": "Display Logseq DB library parents on page references.",
  "main": "index.html",
  "effect": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite build --watch",
    "generate:icons": "node scripts/generate-icon-data.mjs",
    "build": "pnpm generate:icons && tsc --noEmit && vite build",
    "package": "pnpm build && mkdir -p release && zip -r -FS release/logseq-library-display.zip package.json README.md LICENSE icon.svg index.html docs vendor dist"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "db-graph",
    "library",
    "page-reference"
  ],
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "^0.0.17"
  },
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@tabler/icons-webfont": "^3.41.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "logseq": {
    "id": "logseq-library-display",
    "title": "Logseq Library Display",
    "icon": "icon.svg"
  }
}
